{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "墨笺",
  "version": "0.3.0",
  "identifier": "com.maokk.mojian",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "墨笺",
        "width": 800,
        "height": 600,
        "minWidth": 200,
        "minHeight": 150,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "墨笺 Markdown 文档",
        "role": "Editor"
      },
      {
        "ext": ["html", "htm"],
        "name": "墨笺 HTML 文档",
        "role": "Editor"
      },
      {
        "ext": ["pdf"],
        "name": "墨笺 PDF 文档",
        "role": "Editor"
      },
      {
        "ext": ["svg"],
        "name": "墨笺 SVG 文档",
        "role": "Editor"
      }
    ]
  }
}
